From b225b545a01ed2f0e12d090b840fbad0381fbf79 Mon Sep 17 00:00:00 2001
From: hudeng <hudeng@deepin.org>
Date: Mon, 16 Sep 2024 12:49:59 +0800
Subject: [PATCH] CMake: Fix Threads::Threads global target promotion issue

Refreshed for Debian forky Qt 6.11.2.

diff --git a/configure.cmake b/configure.cmake
index 9c2a01a1..47f8f4c9 100644
--- a/configure.cmake
+++ b/configure.cmake
@@ -24,6 +24,10 @@ endif()
 # Look for Threads in the same scope as OpenSSL package, because OpenSSL sometimes depends on
 # Threads (for static OpenSSL builds) and we want to promote the target to global in the same
 # directory scope.
+# A parent project may already provide a non-global Threads target.
+if(TARGET Threads::Threads)
+    qt_internal_disable_find_package_global_promotion(Threads::Threads)
+endif()
 qt_find_package(Threads MODULE PROVIDED_TARGETS Threads::Threads)
 qt_find_package(WrapOpenSSLHeaders MODULE
     PROVIDED_TARGETS WrapOpenSSLHeaders::WrapOpenSSLHeaders MODULE_NAME core
